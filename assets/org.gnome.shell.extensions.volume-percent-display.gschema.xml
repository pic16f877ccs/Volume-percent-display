<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.volume-percent-display" path="/org/gnome/shell/extensions/volume-percent-display/">
    <key name="position-right-bottom" type="b">
        <default>true</default>
    </key>
    <key name="volume-step" type="i">
        <default>5</default>
        <summary>Volume step size</summary>
        <description>The percentage to increase or decrease volume with each key press (1-20%)</description>
        <range min="1" max="20"/>
    </key>
    </schema>
</schemalist>
